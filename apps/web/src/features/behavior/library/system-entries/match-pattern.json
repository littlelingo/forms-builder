{
  "id": "lib_match_pattern",
  "name": "Match pattern",
  "description": "Show or hide an alert node when the field value does not match a regex pattern",
  "category": "validation",
  "scope": "system",
  "revision": 1,
  "icon": "regex",
  "bindsTo": ["field"],
  "parameters": [
    { "key": "trigger", "type": "enum", "label": "Validate on", "options": ["blur", "change"], "default": "blur" },
    { "key": "pattern", "type": "string", "label": "Regex pattern", "required": true },
    { "key": "alertNode", "type": "nodeRef", "label": "Alert node to show on mismatch", "required": true }
  ],
  "template": {
    "eventName": "field.{{trigger}}",
    "enabled": true,
    "conditions": [
      {
        "id": "cond-has-value",
        "enabled": true,
        "source": { "kind": "event_payload", "path": "value" },
        "operator": "exists"
      }
    ],
    "actions": [
      {
        "id": "action-show-alert",
        "kind": "show_node",
        "target": { "nodeId": "{{alertNode}}" },
        "config": {},
        "continueOnError": false
      }
    ]
  },
  "i18n": {
    "en": {
      "name": "Match pattern",
      "description": "Show or hide an alert node when the field value does not match a regex pattern"
    }
  }
}
